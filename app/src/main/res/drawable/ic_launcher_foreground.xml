<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground — simple sun used as the app icon.
    Drawn on a 108×108dp canvas; the safe zone for adaptive icons is the central 72×72dp.
    Generate production-quality icons with Android Studio → New → Image Asset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sun disc -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,40 a14,14 0 1,0 0.001,0 Z" />

    <!-- Sun rays (8 short lines radiating outward) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="
            M54,20 L54,26
            M54,82 L54,88
            M20,54 L26,54
            M82,54 L88,54
            M31.5,31.5 L36,36
            M72,72 L76.5,76.5
            M76.5,31.5 L72,36
            M36,72 L31.5,76.5" />
</vector>
